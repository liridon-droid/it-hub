# Multi-stage build for it-hub's React frontend.
#
# Stage 1: build with Vite. Base path defaults to /portal/ (so asset URLs
# resolve when slicedesk's outer nginx proxies /portal/ → this container).
# For the STANDALONE module build (paired + iframe-embedded), pass
# --build-arg VITE_BASE_PATH=/ so assets + API URLs resolve at the origin root.
#
# Stage 2: serve dist/ with nginx. In standalone mode this nginx also
# reverse-proxies /api + /uploads to the server (see nginx.client.conf);
# behind slicedesk's outer nginx those are routed upstream instead.

FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm install --no-audit --no-fund

# vite.editor.config.js is required too: `npm run build` runs build:editor
# first (package.json), which bundles the React/Lexical guide-editor island
# into public/assets/ before the main build copies public/ into dist/. Without
# it the image build fails on a missing config file.
# tailwind.editor.config.js is REQUIRED here: vite.editor.config.js imports it
# (for the editor island's scoped Tailwind). Omitting it builds fine locally --
# where the file is simply present -- and fails only inside the image, with
# "Could not resolve ./tailwind.editor.config.js". If you add a local import to
# either vite config, add the file here too.
COPY index.html vite.config.js vite.editor.config.js tailwind.editor.config.js ./
COPY src ./src
COPY public ./public

ARG VITE_BASE_PATH=/portal/
ENV VITE_BASE_PATH=$VITE_BASE_PATH
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.client.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
