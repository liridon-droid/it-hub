# Multi-stage build for it-hub's React frontend.
#
# Stage 1: build with Vite — base path is /portal2/ so asset URLs in
# the resulting index.html resolve correctly when slicedesk's nginx
# proxies /portal2/ → this container.
#
# Stage 2: serve dist/ with nginx. Internal nginx is dumb: it just
# serves files from /usr/share/nginx/html with an SPA fallback for
# React Router-style URLs. Slicedesk's outer nginx handles routing
# /portal2/api/* and /portal2/uploads/* to the server container.

FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm install --no-audit --no-fund

COPY index.html vite.config.js ./
COPY src ./src
COPY public ./public

RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.client.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
